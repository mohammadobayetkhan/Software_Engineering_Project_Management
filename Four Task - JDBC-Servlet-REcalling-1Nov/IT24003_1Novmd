## Complete Java Source Code

**File: Main.java**

```java
import java.sql.*;
import java.util.Scanner;

public class Main {

    public static boolean isPrime(int number) {
        if (number < 2) {
            return false;
        }

        for (int i = 2; i <= number / i; i++) {
            if (number % i == 0) {
                return false;
            }
        }

        return true;
    }

    public static long findNthPrime(int n) {
        int count = 0;
        long number = 1;

        while (count < n) {
            number++;

            if (isPrime((int) number)) {
                count++;
            }
        }

        return number;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter n: ");
        int n = sc.nextInt();

        if (n <= 0) {
            System.out.println("Enter a positive integer.");
            return;
        }

        long prime = findNthPrime(n);

        String url = "jdbc:mysql://localhost:3306/prime_db";
        String username = "root";
        String password = "YOUR_MYSQL_PASSWORD";

        try (Connection con =
                     DriverManager.getConnection(url, username, password)) {

            String sql = "INSERT INTO obayet_khan_prime " +
                         "(input_n, prime_number) VALUES (?, ?)";

            PreparedStatement ps = con.prepareStatement(sql);

            ps.setInt(1, n);
            ps.setLong(2, prime);

            ps.executeUpdate();

            System.out.println("The " + n +
                    "th prime number is: " + prime);

            String query = "SELECT * FROM obayet_khan_prime";
            Statement st = con.createStatement();
            ResultSet rs = st.executeQuery(query);

            System.out.println("\nStored Records:");

            while (rs.next()) {
                System.out.println(
                    rs.getInt("id") + " | " +
                    rs.getInt("input_n") + " | " +
                    rs.getLong("prime_number")
                );
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        sc.close();
    }
}
```

**Note:** Replace `YOUR_MYSQL_PASSWORD` with your actual MySQL root password before running the program.

